# .husky/pre-push
#!/bin/sh

set -eu

remote="$1"
url="$2"

repo_root=$(git rev-parse --show-toplevel)
config_file="$repo_root/src-tauri/tauri.conf.json"

if test ! -f "$config_file"
then
	echo >&2 "pre-push: missing config file: $config_file"
	exit 1
fi

version=$(grep -m1 '"version"' "$config_file" | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')

if test -z "$version"
then
	echo >&2 "pre-push: could not read version from $config_file"
	exit 1
fi

tag_name="v$version"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
head_oid=$(git rev-parse HEAD)
should_tag=0

while read -r local_ref local_oid remote_ref remote_oid
do
	if test "$local_oid" = "$zero"
	then
		continue
	fi

	should_tag=1
	break
done

if test "$should_tag" = "1"
then
	git tag -f "$tag_name" "$head_oid" >/dev/null
	echo >&2 "pre-push: updated $tag_name -> $head_oid"
fi

exit 0
